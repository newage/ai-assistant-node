# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
# Effort: low | medium | high | xhigh | max (empty = API default for the model)
CLAUDE_EFFORT=low
# Limits: output tokens per Claude call, request size
CLAUDE_MAX_TOKENS=1024
MAX_MESSAGES=4
MAX_MESSAGE_CHARS=200

# With the reranker on, VECTOR_MIN_SCORE is only a coarse prefilter (lower it, ~0.75)
VECTOR_MIN_SCORE=0.84
# Pinecone rerank model; empty = reranker off. RERANK_MIN_SCORE: calibrate with `npm run measure-score`
RERANK_MODEL=
RERANK_MIN_SCORE=0.5
# Pinecone hits per query; chunks of one parent_id are grouped afterwards
VECTOR_TOP_K=10

PINECONE_API_KEY=
PINECONE_INDEX_NAME=
# Seed: index field_map must embed this field; namespace empty = default
PINECONE_TEXT_FIELD=text
PINECONE_NAMESPACE=

ENVIRONMENT=local
