#!/usr/bin/env bash
# Runs all JS tests inside the already running docker container (does not start it).
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
COMPOSE="docker compose -f docker/docker-compose.yml"

if [ -z "$($COMPOSE ps --status running -q app 2>/dev/null)" ]; then
  echo "pre-commit: container 'app' is not running. Start it first: make -C docker up" >&2
  exit 1
fi

echo "pre-commit: running tests in container..."
$COMPOSE exec -T app npm test
